# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.local
# 生产环境必须换成足够长的随机值：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- 通过 Cloudflare Tunnel 发布到外网（生产模式）----
# 外网访问的域名（可逗号分隔多个）。会自动加入 ALLOWED_HOSTS，并以 https://<域名> 加入 CSRF 可信来源；
# 不设置会导致外网访问报 400（DisallowedHost）、登录提交报 403（CSRF）。
#   固定域名（命名隧道）：DJANGO_PUBLIC_HOSTNAME=parts.example.com
#   快速隧道（cloudflared tunnel --url，每次启动域名都变）：以点开头表示允许所有子域
# DJANGO_PUBLIC_HOSTNAME=.trycloudflare.com
# gunicorn 监听地址（scripts/serve.sh 使用），须与 cloudflared --url 指向的端口一致
# GUNICORN_BIND=127.0.0.1:8000
# 其他需要额外信任的来源（完整的 https:// 地址），一般不需要
# DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS 在 Cloudflare 终止，Cookie 必须只走 HTTPS：保持 true
DJANGO_SECURE_COOKIES=true
# HTTP→HTTPS 跳转与 HSTS 建议在 Cloudflare 开启（Always Use HTTPS / HSTS）；也可以在这里开启
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# 仅当该域名的所有子域都只走 HTTPS 时才开启：
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=true
# Docker 部署时 cloudflared 服务使用的隧道令牌（Cloudflare 控制台 → Networks → Tunnels 创建隧道后获得）
# CLOUDFLARE_TUNNEL_TOKEN=

# ---- 数据库 ----
# 本机：共用已有 PG 实例中的独立库（见 scripts/create_db.sql）
DATABASE_URL=postgres://vehicle_parts:change-me@127.0.0.1:5441/vehicle_parts
# docker compose：web 服务会用下列变量连接 compose 内的 db 服务
POSTGRES_DB=vehicle_parts
POSTGRES_USER=vehicle_parts
POSTGRES_PASSWORD=change-me
WEB_PORT=8000
