# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 服务器（docker compose）上用 production；CSRF 可信来源，逗号分隔
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_CSRF_TRUSTED_ORIGINS=https://parts.example.com

# ---- 数据库 ----
# 本机开发：共用已有 PG 实例中的独立库（见 scripts/create_db.sql）
DATABASE_URL=postgres://vehicle_parts:change-me@127.0.0.1:5441/vehicle_parts
# docker compose：web 服务会用下列变量连接 compose 内的 db 服务
POSTGRES_DB=vehicle_parts
POSTGRES_USER=vehicle_parts
POSTGRES_PASSWORD=change-me
WEB_PORT=8000
# 未配置 HTTPS 的服务器上需设为 false，否则无法登录
DJANGO_SECURE_COOKIES=true
